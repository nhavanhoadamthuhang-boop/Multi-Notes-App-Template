<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FFF9F9F9"
    android:id="@+id/widget_root">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ghi chú &amp; Bình luận"
        android:textColor="#333333"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFFFF"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:elevation="2dp">

        <TextView
            android:id="@+id/widget_note_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ghi chú mới nhất"
            android:textColor="#1976D2"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"/>

        <TextView
            android:id="@+id/widget_note_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Không có ghi chú"
            android:textColor="#555555"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFFFF"
        android:padding="8dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bình luận mới nhất"
            android:textColor="#388E3C"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"/>

        <TextView
            android:id="@+id/widget_comment_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Không có bình luận"
            android:textColor="#555555"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

</LinearLayout>
